def handle_call_tool(tool_name, arguments):
    cwd = arguments.get("workspace_path", ".")
    if not os.path.isabs(cwd):
        cwd = os.path.abspath(cwd)

    if tool_name == "read_status":
        rc, out = run_cmd([READ_ENGINE, "status"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_init":
        rc, out = run_cmd([READ_ENGINE, "init"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_define":
        task_id = arguments.get("task_id", "")
        chash = arguments.get("contract_hash", "")
        bcommit = arguments.get("base_commit", "")
        rc, out = run_cmd([READ_ENGINE, "define", task_id, chash, bcommit], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_build":
        rc, out = run_cmd([READ_ENGINE, "build"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_verify":
        diff_hash = arguments.get("diff_hash", "")
        verify_log = arguments.get("verify_log", "")
        rc, out = run_cmd([READ_ENGINE, "verify", diff_hash, verify_log], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_handoff":
        rc, out = run_cmd([READ_ENGINE, "handoff"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_recover":
        rc, out = run_cmd([READ_ENGINE, "recover"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_override":
        op = arguments.get("operator", "")
        rat = arguments.get("rationale", "")
        rc, out = run_cmd([READ_ENGINE, "override", op, rat], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_diff_hash":
        rc, out = run_cmd([READ_ENGINE, "diff-hash"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_ast_context":
        target = arguments.get("target_file", "")
        rc, out = run_cmd([READ_ENGINE, "ast-context", target], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_mutate":
        diff_file = arguments.get("diff_file", "")
        rc, out = run_cmd([READ_ENGINE, "mutate", diff_file], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_eval_mutation_score":
        k = str(arguments.get("killed", 0))
        t = str(arguments.get("total", 0))
        rc, out = run_cmd([READ_ENGINE, "eval-mutation-score", k, t], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_anchor_wal":
        rc, out = run_cmd([READ_ENGINE, "anchor-wal"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_verify_wal_anchor":
        rc, out = run_cmd([READ_ENGINE, "verify-wal-anchor"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_learn":
        act = arguments.get("action", "progress")
        args = [READ_ENGINE, "learn", act]
        if act == "scenario" and "scenario_id" in arguments:
            args.append(str(arguments["scenario_id"]))
        rc, out = run_cmd(args, cwd=cwd)
        return rc == 0, out

    if tool_name == "read_config":
        rc, out = run_cmd([READ_ENGINE, "config"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_scan":
        rc, out = run_cmd([READ_CLI, "scan"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_status_yaml":
        rc, out = run_cmd([READ_ENGINE, "status", "--yaml"], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_asm":
        opcodes = arguments.get("opcodes", "")
        rc, out = run_cmd([READ_ENGINE, "asm", opcodes], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_run":
        prompt = arguments.get("prompt", "")
        rc, out = run_cmd([READ_CLI, "run", prompt], cwd=cwd)
        return rc == 0, out

    if tool_name == "read_report_html":
        out_path = arguments.get("out_path", "evidence/reports/report_latest.html")
        rc, out = run_cmd([READ_CLI, "report", "--html", out_path], cwd=cwd)
        return rc == 0, out

    return False, f"Unknown tool: {tool_name}"

def send_response(resp):
    data = json.dumps(resp)
    sys.stdout.write(data + "\n")
    sys.stdout.flush()

def main():
    while True:
        line = sys.stdin.readline()
        if not line:
            break
        line = line.strip()
        if not line:
            continue

        if line.lower().startswith("content-length:"):
            try:
                length = int(line.split(":")[1].strip())
                sys.stdin.readline()
                content = sys.stdin.read(length)
                req = json.loads(content)
            except Exception as e:
                continue
        else:
            try:
                req = json.loads(line)
            except Exception as e:
                continue

        req_id = req.get("id")
        method = req.get("method")
        params = req.get("params", {})

        if method == "initialize":
            send_response({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": {
                        "name": "read-mcp",
                        "version": "0.7.0"
                    }
                }
            })
        elif method == "notifications/initialized":
            pass
        elif method == "tools/list":
            send_response({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": TOOLS
                }
            })
        elif method == "tools/call":
            tool_name = params.get("name")
            arguments = params.get("arguments", {})
            success, text_result = handle_call_tool(tool_name, arguments)
            send_response({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [
                        {
                            "type": "text",
                            "text": text_result
                        }
                    ],
                    "isError": not success
                }
            })
        else:
            if req_id is not None:
                send_response({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method not found: {method}"
                    }
                })

if __name__ == "__main__":
    main()
