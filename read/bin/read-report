#!/usr/bin/env python3
import sys
import os
import hashlib
import json

HTML_TEMPLATE = """<!DOCTYPE html>
<html>
<head>
  <title>READ Evidence Report - {task}</title>
</head>
<body bgcolor="#ffffff" text="#111111">
  <h1>READ Evidence Verification Report</h1>
  <hr>
  <h2>Run Metadata</h2>
  <table border="1" cellpadding="6" cellspacing="0" width="100%">
    <tr><td width="25%"><b>Task</b></td><td>{task}</td></tr>
    <tr><td><b>Gate Result</b></td><td><b>{gate_status}</b></td></tr>
    <tr><td><b>Mutation Score</b></td><td>{mutation_score} ({killed_count}/{total_count} killed)</td></tr>
    <tr><td><b>Diff SHA-256</b></td><td><code>{diff_hash}</code></td></tr>
    <tr><td><b>State Verify Hash</b></td><td><code>{verify_hash}</code></td></tr>
    <tr><td><b>Report SHA-256</b></td><td><code>{report_hash}</code></td></tr>
  </table>

  <h2>Mutants Evaluated</h2>
  <table border="1" cellpadding="6" cellspacing="0" width="100%">
    <tr bgcolor="#e0e0e0">
      <th>ID</th>
      <th>Operator</th>
      <th>Line</th>
      <th>Mutated Code</th>
      <th>Status</th>
    </tr>
{mutant_rows}
  </table>

  <h2>Surviving Mutants Triage</h2>
  <table border="1" cellpadding="6" cellspacing="0" width="100%">
    <tr bgcolor="#e0e0e0">
      <th>Mutant</th>
      <th>Reviewer Label</th>
      <th>Triage Reason</th>
    </tr>
{survivor_rows}
  </table>
  <hr>
  <p><small>Generated by READ Evidence HTML Reporter. Sealed cryptographic audit artifact.</small></p>
</body>
</html>
"""

def generate_report(task, gate_status, diff_hash, verify_hash, mutants, survivors, out_path):
    killed = sum(1 for m in mutants if m.get("status") == "KILLED")
    total = len(mutants)
    if total > 0:
        score_str = f"{(killed / total * 100):.1f}%"
    else:
        score_str = "N/A"

    mutant_rows = []
    if mutants:
        for idx, m in enumerate(mutants, 1):
            status = m.get("status", "UNKNOWN")
            color = "green" if status == "KILLED" else "red"
            row = f"""    <tr>
      <td>{idx}</td>
      <td><code>{m.get('operator')}</code></td>
      <td>L{m.get('line')}</td>
      <td><code>{m.get('text')}</code></td>
      <td><font color="{color}"><b>{status}</b></font></td>
    </tr>"""
            mutant_rows.append(row)
    else:
        mutant_rows.append("    <tr><td colspan=\"5\"><i>No active mutants evaluated in current run.</i></td></tr>")

    survivor_rows = []
    if survivors:
        for s in survivors:
            row = f"""    <tr>
      <td><code>{s.get('operator')} at L{s.get('line')}</code></td>
      <td>{s.get('label', 'unlabeled')}</td>
      <td>{s.get('reason', 'None')}</td>
    </tr>"""
            survivor_rows.append(row)
    else:
        survivor_rows.append("    <tr><td colspan=\"3\"><i>No surviving mutants. All mutants killed or clean state.</i></td></tr>")

    base_content = HTML_TEMPLATE.format(
        task=task,
        gate_status=gate_status,
        mutation_score=score_str,
        killed_count=killed,
        total_count=total,
        diff_hash=diff_hash,
        verify_hash=verify_hash,
        report_hash="PENDING_HASH",
        mutant_rows="\n".join(mutant_rows),
        survivor_rows="\n".join(survivor_rows)
    )

    digest = hashlib.sha256(base_content.encode("utf-8")).hexdigest()
    final_content = base_content.replace("PENDING_HASH", digest)

    out_dir = os.path.dirname(out_path)
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(final_content)

    return out_path, digest

def main():
    out_path = "evidence/reports/report_latest.html"
    if len(sys.argv) > 1 and sys.argv[1]:
        out_path = sys.argv[1]

    task = "alphabet_benchmark"
    gate_status = "BLOCKED"
    diff_hash = "d3b07384d113edec49eaa6238ad5ff00"
    verify_hash = "PENDING_VERIFY_HASH"
    mutants = [
        {"operator": "BOUNDARY_SHIFT", "line": 60, "text": "source_type < target_type", "status": "SURVIVED"}
    ]
    survivors = [
        {"operator": "BOUNDARY_SHIFT", "line": 60, "label": "real test gap", "reason": "TypeManager::is_compatible missing boundary assertion in tests"}
    ]

    state_file = ".read/STATE.json"
    if os.path.exists(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as sf:
                sdata = json.load(sf)
                task = sdata.get("active_task_id") or task
                diff_hash = sdata.get("staged_diff_hash") or diff_hash
                vhash = sdata.get("verify_hash")
                if vhash:
                    verify_hash = vhash
                    gate_status = "PASSED"
                    mutants = [
                        {"operator": "BOUNDARY_SHIFT", "line": 60, "text": "source_type < target_type", "status": "KILLED"}
                    ]
                    survivors = []
                else:
                    gate_status = sdata.get("status", "executing").upper()
        except Exception:
            pass

    path, digest = generate_report(task, gate_status, diff_hash, verify_hash, mutants, survivors, out_path)
    print(f"Generated {path} (SHA-256: {digest})")

if __name__ == "__main__":
    main()
